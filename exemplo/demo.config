## Grupo de demonstração do scriptLattes
##
## Usa três currículos SINTÉTICOS (inventados) que já vêm no projeto, em
## exemplo/demo-lattes/cache/. Por isso este exemplo roda sem internet, sem
## Google Chrome e sem baixar nada: é a forma mais rápida de ver o scriptLattes
## funcionando de ponta a ponta.
##
## Uso:  python scriptLattes.py exemplo/demo.config
##       (ou apenas ./executar.sh  /  executar.bat, sem argumentos)
##
## Para regenerar os currículos sintéticos:
##   python exemplo/demo-lattes/gerar_cvs_sinteticos.py

global-nome_do_grupo                      = Grupo de Demonstração (dados sintéticos)
global-arquivo_de_entrada                 = ./exemplo/demo-lattes/demo.list
global-diretorio_de_saida                 = ./exemplo/demo-lattes/saida/
global-diretorio_de_armazenamento_de_cvs  = ./exemplo/demo-lattes/cache/
global-itens_desde_o_ano                  = 1900
global-itens_ate_o_ano                    = hoje
